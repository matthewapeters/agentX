#!/bin/bash
set -eu

# Fail early and clearly if a hard dependency is missing, rather than opening a
# multiplexer full of dead panes.
if ! command -v agentx >/dev/null 2>&1; then
	echo "ax: agentx not found on PATH — build it (make all) and put ./bin on PATH" >&2
	exit 1
fi
if ! command -v zellij >/dev/null 2>&1; then
	echo "ax: zellij not found on PATH — install it to run the surface layout" >&2
	exit 1
fi

# -r <session name>: resume an existing session instead of minting a new one.
# AX_CHAT_FLAG picks which flag the chat pane launches agentx with — --resume
# (matched against a session's ID or adjective-noun name, see
# docs/architecture/behavior/session_resume.feature.md) instead of --session
# (which always starts fresh). AX_SESSION_STRING still drives every pane's
# --session selector either way: the surface panes auto-resolve by name/id
# against whatever session ends up running (SS-5), so they need no flag swap.
AX_CHAT_FLAG="--session"
if [ "${1:-}" = "-r" ]; then
	if [ "${2:-}" = "" ]; then
		echo "ax: -r requires a session name" >&2
		exit 1
	fi
	AX_SESSION_STRING=$2
	AX_CHAT_FLAG="--resume"
else
	# Mint a session name in AgentX's own adjective-noun style (filesystem-safe,
	# human-readable, and unique among sessions already on disk).
	AX_SESSION_STRING=$(agentx session new-name)
fi
export AX_SESSION_STRING AX_CHAT_FLAG
echo "$AX_SESSION_STRING"

zellij --layout ~/.config/agentx/agentx.kdl
